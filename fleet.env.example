# Fleet poller settings. Copy to fleet.env (gitignored). Only the fleet-poller
# container loads this file, so the web app never holds these keys.
# A source left blank shows as "not configured" on the Fleet Now page.

# Foreman (Metered Mining hosted miners): Dashboard -> profile -> API.
# This key can also change miner settings; keep it here only.
FOREMAN_API_KEY=
FOREMAN_CLIENT_ID=

# Clore.ai host API key. It can also reprice servers and spend balance.
CLORE_API_KEY=

# Vast.ai host API key. Create a restricted one (cloud.vast.ai -> Keys, or
# `vastai create api-key --permission_file perms.json` with
# {"api": {"machine_read": {}, "billing_read": {}}}) so it can't list/unlist or spend.
VAST_API_KEY=

# Kryptex pool wallets (public, read-only): coin:address,coin:address
KRYPTEX_WALLETS=

# Home ASICs over the LAN (cgminer API, port 4028): name=ip,name=ip:port
# Use the same names as the PowerPool workers so rows merge.
LAN_MINERS=

# Networked rack PDUs, read-only over SNMPv2c (outlets are never switched from here).
# Enable SNMP with a read-only community in each PDU's web UI first.
# name=host[@community],...   Supported: Chatsworth eConnect, APC Switched Rack PDU 2G.
PDU_DEVICES=
PDU_SNMP_COMMUNITY=public
